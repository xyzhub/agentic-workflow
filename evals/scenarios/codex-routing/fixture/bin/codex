#!/usr/bin/env node
// Fake Codex CLI for the codex-routing eval — no network, no real model.
// evals/run.mjs points the adapter's CODEX_BIN at this file, so the scenario
// can never reach the real `codex`. It emits a canned --json event stream,
// writes a schema-valid distillate to the -o file, and makes ONE real file
// change in its cwd so the adapter's git-derived changed_paths is non-empty
// (an empty changed_paths on `done` is treated as suspicious upstream).
const fs = require('node:fs');
const path = require('node:path');
const argv = process.argv.slice(2);

if (argv.includes('--version')) {
  process.stdout.write('codex-cli 0.146.0 (fake)\n');
  process.exit(0);
}

// A real edit so `git status --porcelain` in cwd is non-empty.
try {
  const f = path.join(process.cwd(), 'src', 'tags.js');
  fs.mkdirSync(path.dirname(f), { recursive: true });
  fs.appendFileSync(f, 'export const withTag = (note, t) => ({ ...note, tags: [...(note.tags || []), t] });\n');
} catch { /* best effort */ }

// Canned event stream — the adapter mines thread_id + usage from it.
process.stdout.write([
  '{"type":"thread.started","thread_id":"thr_eval_codex"}',
  '{"type":"item.completed","item":{"type":"reasoning"}}',
  '{"type":"turn.completed","usage":{"input_tokens":1200,"output_tokens":300}}',
].join('\n') + '\n');

// The model's FINAL message → the -o file. A schema-valid distillate.
const o = argv.indexOf('-o');
if (o >= 0 && argv[o + 1]) {
  fs.writeFileSync(argv[o + 1], JSON.stringify({
    status: 'done',
    summary: 'Added a tags field to notes and a filter-by-tag path on CLI + HTTP.',
    changed_paths: ['src/tags.js'],
    gates: [{ name: 'node tools/lint.mjs', result: 'green', first_error: null }],
    deviations: [],
    next: ['reviewer: confirm the tag filter covers the HTTP surface'],
    blocked_reason: null,
    runtime: { name: 'codex', model: 'gpt-6-astra', effort: 'medium', thread_id: null },
    usage: null,
    high_impact_touched: null,
  }));
}
process.exit(0);
