# agentic-workflow — Codex execpolicy guardrails
#
# WHY THIS FILE EXISTS. The plugin's shell guardrails are Claude Code hooks
# (hooks/hooks.json): they fire on Claude tool calls and on nothing else. A run
# delegated to the Codex CLI never touches those hooks, so the mechanical
# blocks — never push, never commit, never open or merge a PR — have to be
# restated in the one place Codex does enforce: its execpolicy layer.
#
# WHERE IT IS DEPLOYED. `<repo>/.codex/rules/agentic-workflow.rules`, committed
# in the consumer repo. That directory is Codex's **Project** config layer
# (`$(git rev-parse --show-toplevel)/.codex/rules/*.rules`); every layer's
# `rules/` folder loads automatically, so no flag points at this file. There is
# deliberately no user-level copy: the guardrail travels with the repo it
# guards. `/connect codex` writes it from this template.
#
# THE TRUST GATE (read this before you trust the file). Project-layer rules are
# loaded but **disabled until the project is trusted**. Trust is a user-level
# entry in `~/.codex/config.toml`:
#
#     [projects."<absolute path to the repo>"]
#     trust_level = "trusted"
#
# Without that entry this file is inert and every command below is allowed.
# `/connect codex` adds the entry as an explicit, owner-approved step — never a
# silent edit — and proves it with a live round trip.
#
# `codex execpolicy check --rules <this file> <command>` answers a different,
# narrower question: does the FILE decide this command? It reads the file only
# and never consults the trust layer, so a `forbidden` verdict here says the
# syntax and the pattern are right, not that the rule is live in a session.
#
# WHAT IS NOT HERE, AND WHY. `prefix_rule` tokens are matched literally — there
# are no globs. Alternatives are written as nested lists, e.g.
# `["git", ["push", "commit", "tag"]]`. The §14 paid-promotion / publish HOST
# guards are not expressed here as command rules; a `network_rule(host=…,
# protocol="https", decision="forbidden")` form parses in 0.146.0 but is not
# used or verified yet — probe it at n=1. For now a read-only role is covered by
# the network-off sandbox, and a builder role with network on is a named,
# accepted gap (mission Risks, the `## Closing` row, WORKFLOW.md §3).
#
# THE RESIDUE LITERAL TOKENS CANNOT CLOSE. Two forms slip past the rules below by
# construction, because a prefix token is compared literally:
#   • equals-forms of an option — `git --git-dir=/x status` tokenizes as
#     `["git", "--git-dir=/x", …]`, so the `--git-dir` token never matches (the
#     space form `git --git-dir /x` does, and IS blocked). Same for
#     `--work-tree=…`, `--namespace=…`.
#   • an absolute-path executable — `/usr/bin/git push` presents the token
#     `/usr/bin/git`, not `git`, so no `["git", …]` rule fires.
# `codex execpolicy check --resolve-host-executables` resolves absolute program
# paths against basename rules (gated by `host_executable()` definitions); it is
# noted here, not relied on. Sandbox mode is the backstop: a read-only role
# cannot write, and network is off unless the adapter turns it on.
#
# HOW THE EXAMPLES ARE READ. Each rule below carries machine-readable examples,
# one command per line, with the stable prefixes `# match:` and `# not_match:`.
# `tools/run-codex-test.mjs` enumerates them and runs every one through
# `codex execpolicy check`, so the examples are the test, not decoration.
# The adapter never passes `--ignore-rules`; that flag would switch this file off.

# ── 1. The git history belongs to the orchestrator ──────────────────────────
# covers: git push, git commit, git tag
# match: git push
# match: git push origin main
# match: git push --tags origin
# match: git commit -m wip
# match: git commit --amend --no-edit
# match: git tag v1.2.0
# not_match: git status
# not_match: git diff --stat
# not_match: git log --oneline -5
prefix_rule(
    pattern = ["git", ["push", "commit", "tag"]],
    decision = "forbidden",
    justification = "The orchestrator owns the git history: it commits from your distillate (which keeps the commit-format and close-keyword guards in force), it pushes, and a human merges. A delegated run never commits, pushes or tags. Report your changed paths and stop.",
)

# ── 2. Opening and merging pull requests is a human/orchestrator action ──────
# covers: gh pr create, gh pr merge
# match: gh pr create --fill
# match: gh pr create --base main --head feature
# match: gh pr merge 12 --squash
# not_match: gh pr view 12
# not_match: gh pr list --state open
# not_match: gh issue view 79
prefix_rule(
    pattern = ["gh", "pr", ["create", "merge"]],
    decision = "forbidden",
    justification = "Opening a PR is the orchestrator's step after the phase gate, and merging is the human's call under the merge policy in WORKFLOW.md §10 — never a delegated run's, even when merge authority is delegated. Reading PRs (`gh pr view`, `gh pr list`) stays allowed.",
)

# ── 3. No reaching outside the working directory Codex was given ────────────
# covers: git -C
# match: git -C /tmp push
# match: git -C /tmp/other-repo push origin main
# match: git -C .. commit -m x
# match: git -C /tmp status
# not_match: git status
# not_match: git add -A
prefix_rule(
    pattern = ["git", "-C"],
    decision = "forbidden",
    justification = "The adapter sets this run's working directory, so `git -C <dir>` only ever reaches a repository you were not sent to work in. It is also the bypass rule 1 cannot see — `git -C <dir> push` puts the subcommand past the matched prefix, and with no globs no pattern could catch it — so the whole form is blocked, read-only uses included. Run git in your own working directory.",
)

# ── 4. Shell wrappers hide the real command from every rule above ────────────
# covers: sh -c
# match: sh -c git push
# match: sh -c 'gh pr merge 1'
# not_match: sh script.sh
# not_match: ls -la
prefix_rule(
    pattern = ["sh", "-c"],
    decision = "forbidden",
    justification = "A shell wrapper hides the real command from every prefix rule below: `sh -c 'git push'` puts the push inside a string argument no literal token can inspect, so none of rules 1-3 can see it. A delegated run already has a shell; it never needs to wrap one to reach a plain command.",
)

# covers: bash -c
# match: bash -c git push
# match: bash -c 'gh pr merge 1'
# not_match: bash script.sh
# not_match: ls -la
prefix_rule(
    pattern = ["bash", "-c"],
    decision = "forbidden",
    justification = "Same bypass as `sh -c`: `bash -c 'gh pr merge 1'` smuggles a forbidden command inside a string argument no prefix token can reach. NOTE: `bash -lc` is deliberately NOT blocked — Codex's own shell tool may wrap commands that way, and whether the session unwraps it is settled at the `/connect codex` round trip, not here.",
)

# covers: zsh -c
# match: zsh -c git push
# match: zsh -lc 'gh pr merge 1'
# match: zsh -ic git push
# not_match: zsh script.sh
# not_match: ls -la
prefix_rule(
    pattern = ["zsh", ["-c", "-lc", "-ic"]],
    decision = "forbidden",
    justification = "`zsh -c` / `-lc` / `-ic` are the same string-argument bypass as `sh -c`, one alternative per shell-invocation flavour. A delegated run has no reason to launch an interactive or login zsh to run a single command.",
)

# covers: env
# match: env git push
# match: env FOO=bar git push
# not_match: printenv PATH
# not_match: ls -la
prefix_rule(
    pattern = ["env"],
    decision = "forbidden",
    justification = "`env FOO=bar git push` (or a bare `env git push`) runs an arbitrary command after optional VAR=VALUE pairs, so the real executable sits past the matched prefix where no literal token can catch it. The adapter already sets this run's environment; reading it needs `printenv`, not `env <cmd>`.",
)

# covers: command
# match: command git push
# match: command gh pr merge 1
# not_match: ls -la
# not_match: node tools/lint.mjs
prefix_rule(
    pattern = ["command"],
    decision = "forbidden",
    justification = "`command git push` uses the shell builtin to run the binary directly, moving the real command past the matched prefix (and stripping any function shadowing). A delegated run never needs the `command` builtin to reach a plain executable.",
)

# covers: nohup
# match: nohup git push
# match: nohup gh pr merge 1
# not_match: ls -la
# not_match: node tools/lint.mjs
prefix_rule(
    pattern = ["nohup"],
    decision = "forbidden",
    justification = "`nohup git push &` detaches a command so it outlives the sandboxed process and hides its argv behind the `nohup` prefix. Delegated work is synchronous and owns no background daemons.",
)

# covers: xargs
# match: xargs git push
# match: xargs -n1 gh pr merge
# not_match: ls -la
# not_match: node tools/lint.mjs
prefix_rule(
    pattern = ["xargs"],
    decision = "forbidden",
    justification = "`xargs` builds and runs a command from its stdin, so the executable never appears in the argv these rules inspect. A delegated run has no pipeline that must fan out into a spawned command.",
)

# covers: timeout
# match: timeout 5 git push
# match: timeout 30s gh pr merge 1
# not_match: ls -la
# not_match: node tools/lint.mjs
prefix_rule(
    pattern = ["timeout"],
    decision = "forbidden",
    justification = "`timeout 5 git push` runs an arbitrary command after its duration argument, past the matched prefix. The adapter bounds runtime itself; a delegated run never needs `timeout` to wrap another command.",
)

# ── 5. git global options before the subcommand push it past rule 1 ─────────
# The space form is blocked; the equals form (`--git-dir=/x`) is a documented
# residue literal tokens cannot close (see the header). `-c` also sets config
# that changes what a later command does.
# covers: git -c
# match: git -c x=y push
# match: git --no-pager log
# match: git -p log
# match: git --git-dir /x status
# match: git --work-tree /x add
# match: git --exec-path status
# match: git --namespace x status
# not_match: git status
# not_match: git add -A
prefix_rule(
    pattern = ["git", ["-c", "--no-pager", "-p", "--git-dir", "--work-tree", "--exec-path", "--namespace"]],
    decision = "forbidden",
    justification = "A git global option before the subcommand (`git -c ... push`, `git --git-dir /x commit`) pushes the subcommand past the `[\"git\", [\"push\",\"commit\",\"tag\"]]` prefix, and `-c` can additionally set config that changes what a later command does. The whole global-option-first form is blocked; run git plainly in your own working directory.",
)

# ── 6. gh api reaches every write endpoint, bypassing the pr-command rule ────
# covers: gh api
# match: gh api /repos/x/y/merges
# match: gh api -X POST /repos/x/y/pulls
# not_match: gh pr view 1
# not_match: gh issue view 79
prefix_rule(
    pattern = ["gh", "api"],
    decision = "forbidden",
    justification = "`gh api` reaches every GitHub write endpoint directly — `gh api -X POST .../merges`, `.../pulls` — bypassing the `[\"gh\",\"pr\",[\"create\",\"merge\"]]` prefix entirely. Reading via `gh pr view` / `gh pr list` stays allowed; a delegated run performs no raw API writes.",
)
